#include <stdio.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "driver/gpio.h"
#include "esp_lcd_panel_rgb.h"
#include "esp_lcd_panel_ops.h"
#include "esp_log.h"
#include "esp_timer.h"
#include "lvgl.h"

static const char *TAG = "main";

// ==================== GPIO definitions (ESP32-8048S043C) ====================
#define LCD_BL_GPIO         GPIO_NUM_2
#define LCD_PCLK_GPIO       GPIO_NUM_42
#define LCD_HSYNC_GPIO      GPIO_NUM_39
#define LCD_VSYNC_GPIO      GPIO_NUM_41
#define LCD_DE_GPIO         GPIO_NUM_40

static const gpio_num_t data_pins[] = {
    GPIO_NUM_8,  GPIO_NUM_3,  GPIO_NUM_46, GPIO_NUM_9,
    GPIO_NUM_1,  GPIO_NUM_5,  GPIO_NUM_6,  GPIO_NUM_7,
    GPIO_NUM_15, GPIO_NUM_16, GPIO_NUM_4,  GPIO_NUM_45,
    GPIO_NUM_48, GPIO_NUM_47, GPIO_NUM_21, GPIO_NUM_14
};

// ==================== LVGL callbacks ====================
static void lvgl_flush_cb(lv_display_t *disp, const lv_area_t *area, uint8_t *px_map) {
    esp_lcd_panel_handle_t panel = (esp_lcd_panel_handle_t)lv_display_get_user_data(disp);
    // Directly draw the bitmap (no VSYNC wait – works on all IDF versions)
    esp_lcd_panel_draw_bitmap(panel, area->x1, area->y1, area->x2, area->y2, px_map);
    lv_display_flush_ready(disp);
}

static void lvgl_tick_cb(void *arg) {
    lv_tick_inc(5);
}

// ==================== Simple UI ====================
static uint32_t click_count = 0;
static lv_obj_t *counter_label = NULL;

static void button_event_cb(lv_event_t *e) {
    if (lv_event_get_code(e) == LV_EVENT_CLICKED) {
        click_count++;
        lv_label_set_text_fmt(counter_label, "Clicked: %lu times", click_count);
        ESP_LOGI(TAG, "Button clicked! Total: %lu", click_count);
    }
}

static void create_ui(void) {
    lv_obj_set_style_bg_color(lv_screen_active(), lv_color_hex(0x1A1D20), LV_PART_MAIN);

    lv_obj_t *title = lv_label_create(lv_screen_active());
    lv_label_set_text(title, "ESP32-8048S043C\nButton test");
    lv_obj_set_style_text_color(title, lv_color_hex(0x00FFB0), LV_PART_MAIN);
    lv_obj_set_style_text_font(title, &lv_font_montserrat_14, LV_PART_MAIN);
    lv_obj_align(title, LV_ALIGN_TOP_MID, 0, 30);

    counter_label = lv_label_create(lv_screen_active());
    lv_label_set_text(counter_label, "Clicked: 0 times");
    lv_obj_align(counter_label, LV_ALIGN_CENTER, 0, -40);

    lv_obj_t *btn = lv_button_create(lv_screen_active());
    lv_obj_set_size(btn, 180, 50);
    lv_obj_align(btn, LV_ALIGN_CENTER, 0, 40);
    lv_obj_add_event_cb(btn, button_event_cb, LV_EVENT_CLICKED, NULL);

    lv_obj_t *btn_label = lv_label_create(btn);
    lv_label_set_text(btn_label, "Click me!");
    lv_obj_center(btn_label);
}

// ==================== main ====================
extern "C" void app_main(void) {
    vTaskDelay(pdMS_TO_TICKS(500));
    ESP_LOGI(TAG, "Starting RGB display + LVGL (fixed centering)");

    // Backlight: initially off
    gpio_config_t bk_conf = {
        .pin_bit_mask = 1ULL << LCD_BL_GPIO,
        .mode = GPIO_MODE_OUTPUT,
        .pull_up_en = GPIO_PULLUP_DISABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE,
    };
    gpio_config(&bk_conf);
    gpio_set_level(LCD_BL_GPIO, 0);

    // ==================== RGB panel configuration (corrected timings) ====================
    esp_lcd_rgb_panel_config_t panel_conf = {};

    panel_conf.clk_src = LCD_CLK_SRC_PLL160M;
    panel_conf.timings.pclk_hz = 12.5 * 1000 * 1000;      // 16 MHz
    panel_conf.timings.h_res = 800;
    panel_conf.timings.v_res = 480;
    // Horizontal blanking (critical for centering)
    panel_conf.timings.hsync_pulse_width = 4;
    panel_conf.timings.hsync_back_porch = 8;
    panel_conf.timings.hsync_front_porch = 8;
    // Vertical blanking
    panel_conf.timings.vsync_pulse_width = 4;
    panel_conf.timings.vsync_back_porch = 8;
    panel_conf.timings.vsync_front_porch = 8;

    // Signal polarities (correct for most 800x480 RGB panels)
    panel_conf.timings.flags.hsync_idle_low = 0;
    panel_conf.timings.flags.vsync_idle_low = 0;
    panel_conf.timings.flags.de_idle_high = 0;          // DE active high
    panel_conf.timings.flags.pclk_idle_high = 0;
    panel_conf.timings.flags.pclk_active_neg =1;       // positive edge

    panel_conf.data_width = 16;
    panel_conf.in_color_format = LCD_COLOR_FMT_RGB565;
    panel_conf.out_color_format = LCD_COLOR_FMT_RGB565;
    panel_conf.num_fbs = 2;                             // double buffer
    panel_conf.bounce_buffer_size_px = 0;
    panel_conf.dma_burst_size = 64;

    panel_conf.pclk_gpio_num = LCD_PCLK_GPIO;
    panel_conf.hsync_gpio_num = LCD_HSYNC_GPIO;
    panel_conf.vsync_gpio_num = LCD_VSYNC_GPIO;
    panel_conf.de_gpio_num = LCD_DE_GPIO;
    panel_conf.disp_gpio_num = GPIO_NUM_NC;

    for (int i = 0; i < 16; i++) {
        panel_conf.data_gpio_nums[i] = data_pins[i];
    }

    panel_conf.flags.fb_in_psram = 1;

    esp_lcd_panel_handle_t panel_handle = NULL;
    ESP_ERROR_CHECK(esp_lcd_new_rgb_panel(&panel_conf, &panel_handle));
    ESP_ERROR_CHECK(esp_lcd_panel_reset(panel_handle));
    ESP_ERROR_CHECK(esp_lcd_panel_init(panel_handle));

    // Retrieve the two framebuffers
    uint16_t *fb0 = NULL, *fb1 = NULL;
    ESP_ERROR_CHECK(esp_lcd_rgb_panel_get_frame_buffer(panel_handle, 1, (void**)&fb0));
    ESP_ERROR_CHECK(esp_lcd_rgb_panel_get_frame_buffer(panel_handle, 2, (void**)&fb1));

    // ==================== LVGL initialisation ====================
    lv_init();

    esp_timer_handle_t tick_timer;
    esp_timer_create_args_t tick_args = {};
    tick_args.callback = lvgl_tick_cb;
    tick_args.name = "lvgl_tick";
    ESP_ERROR_CHECK(esp_timer_create(&tick_args, &tick_timer));
    ESP_ERROR_CHECK(esp_timer_start_periodic(tick_timer, 5000));   // 5 ms

    lv_display_t *display = lv_display_create(800, 480);
    lv_display_set_buffers(display, fb0, fb1, 800 * 480 * sizeof(uint16_t),
                           LV_DISPLAY_RENDER_MODE_FULL);
    lv_display_set_flush_cb(display, lvgl_flush_cb);
    lv_display_set_user_data(display, panel_handle);

    create_ui();

    // Turn backlight ON
    vTaskDelay(pdMS_TO_TICKS(100));
    gpio_set_level(LCD_BL_GPIO, 1);
    ESP_LOGI(TAG, "System ready – display on, button should be centered now");

    // Main loop
    while (1) {
        lv_timer_handler();
        vTaskDelay(pdMS_TO_TICKS(5));
    }
}